rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;} function isOwner(uid){return signedIn()&&request.auth.uid==uid;} function roleOf(uid){return get(/databases/$(database)/documents/users/$(uid)).data.role;} function isAdmin(){return signedIn()&&exists(/databases/$(database)/documents/users/$(request.auth.uid))&&roleOf(request.auth.uid) in ['ADMIN','SUPER_ADMIN'];} function isSuperAdmin(){return signedIn()&&exists(/databases/$(database)/documents/users/$(request.auth.uid))&&roleOf(request.auth.uid)=='SUPER_ADMIN';}
  match /users/{uid}{allow read:if isOwner(uid)||isAdmin();allow create:if isOwner(uid)&&request.resource.data.uid==request.auth.uid&&request.resource.data.role=='USER';allow update:if isSuperAdmin()||(isAdmin()&&resource.data.role!='SUPER_ADMIN'&&request.resource.data.role==resource.data.role&&request.resource.data.disabled==resource.data.disabled)||(isOwner(uid)&&request.resource.data.uid==resource.data.uid&&request.resource.data.role==resource.data.role);allow delete:if isSuperAdmin();}
  match /users/{uid}/drafts/{id}{allow read,create,update,delete:if isOwner(uid)||isAdmin();}
  match /publicProfiles/{uid}{
   allow read:if true;
   allow create:if isOwner(uid)&&request.resource.data.uid==request.auth.uid
    &&request.resource.data.accountVerified==false
    &&request.resource.data.ticketCount==0&&request.resource.data.settledTicketCount==0
    &&request.resource.data.wonCount==0&&request.resource.data.lostCount==0
    &&request.resource.data.pendingCount==0&&request.resource.data.winRate==0
    &&request.resource.data.selectionWonCount==0&&request.resource.data.selectionLostCount==0
    &&request.resource.data.selectionWinRate==0
    &&request.resource.data.keys().hasOnly(['uid','username','displayName','photoURL','accountVerified','ticketCount','settledTicketCount','wonCount','lostCount','pendingCount','winRate','selectionWonCount','selectionLostCount','selectionWinRate','createdAt','updatedAt']);
   allow update:if isOwner(uid)&&request.resource.data.uid==resource.data.uid
    &&(request.resource.data.accountVerified==resource.data.accountVerified||(!resource.data.keys().hasAny(['accountVerified'])&&request.resource.data.accountVerified==true))
    &&request.resource.data.get('winRate',0)==resource.data.get('winRate',0)
    &&request.resource.data.get('wonCount',0)==resource.data.get('wonCount',0)
    &&request.resource.data.get('lostCount',0)==resource.data.get('lostCount',0)
    &&request.resource.data.get('pendingCount',0)==resource.data.get('pendingCount',0)
    &&request.resource.data.get('ticketCount',0)==resource.data.get('ticketCount',0)
    &&request.resource.data.get('settledTicketCount',0)==resource.data.get('settledTicketCount',0)
    &&request.resource.data.get('selectionWonCount',0)==resource.data.get('selectionWonCount',0)
    &&request.resource.data.get('selectionLostCount',0)==resource.data.get('selectionLostCount',0)
    &&request.resource.data.get('selectionWinRate',0)==resource.data.get('selectionWinRate',0);
   allow delete:if isAdmin();
  }
  match /usernames/{username}{allow read:if true;allow create:if signedIn()&&request.resource.data.uid==request.auth.uid&&!exists(/databases/$(database)/documents/usernames/$(username));allow update:if false;allow delete:if isSuperAdmin();}
  match /matches/{id}{allow read:if true;allow write:if isAdmin();} match /sports/{id}{allow read:if true;allow write:if isAdmin();} match /leagues/{id}{allow read:if true;allow write:if isAdmin();} match /teams/{id}{allow read:if true;allow write:if isAdmin();} match /results/{id}{allow read:if true;allow write:if isAdmin();} match /standings/{id}{allow read:if true;allow write:if isAdmin();} match /api_logs/{id}{allow read:if isAdmin();allow write:if false;}
  match /tickets/{id}{allow get:if resource.data.visibility=='PUBLIC'||(signedIn()&&resource.data.creatorId==request.auth.uid)||isAdmin();allow list:if resource.data.visibility=='PUBLIC'||(signedIn()&&resource.data.creatorId==request.auth.uid)||isAdmin();allow create:if signedIn()&&request.resource.data.creatorId==request.auth.uid&&request.resource.data.status=='PENDING'&&request.resource.data.totalOdds>0;allow update:if isAdmin();allow delete:if isAdmin();match /selections/{sid}{allow read:if get(/databases/$(database)/documents/tickets/$(id)).data.visibility=='PUBLIC'||isAdmin()||(signedIn()&&get(/databases/$(database)/documents/tickets/$(id)).data.creatorId==request.auth.uid);allow create:if signedIn()&&get(/databases/$(database)/documents/tickets/$(id)).data.creatorId==request.auth.uid&&request.resource.data.status=='PENDING'&&request.resource.data.kickoffAt>request.time;allow update,delete:if isAdmin();}}
  match /likes/{id} {
   allow read: if true;
   allow create: if signedIn()
    && request.resource.data.keys().hasAll(['ticketId','userId','createdAt'])
    && request.resource.data.keys().hasOnly(['ticketId','userId','createdAt'])
    && request.resource.data.userId==request.auth.uid
    && request.resource.data.ticketId is string
    && id==request.resource.data.ticketId+'_'+request.auth.uid
    && request.resource.data.createdAt==request.time
    && exists(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId))
    && get(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId)).data.visibility=='PUBLIC';
   allow delete: if signedIn()&&resource.data.userId==request.auth.uid;
   allow update: if false;
  }
  match /comments/{id} {
   allow read: if true;
   allow create: if signedIn()
    && request.resource.data.keys().hasAll(['ticketId','authorId','authorName','text','createdAt'])
    && request.resource.data.keys().hasOnly(['ticketId','authorId','authorName','text','createdAt'])
    && request.resource.data.authorId==request.auth.uid
    && request.resource.data.ticketId is string
    && request.resource.data.authorName is string
    && request.resource.data.authorName.size()>0
    && request.resource.data.authorName.size()<=80
    && request.resource.data.text is string
    && request.resource.data.text.size()>0
    && request.resource.data.text.size()<=1000
    && request.resource.data.createdAt==request.time
    && exists(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId))
    && get(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId)).data.visibility=='PUBLIC';
   allow update,delete: if isAdmin()||(signedIn()&&resource.data.authorId==request.auth.uid);
  }
  match /savedTickets/{id}{allow read:if signedIn()&&resource.data.userId==request.auth.uid;allow create:if signedIn()&&request.resource.data.userId==request.auth.uid&&request.resource.data.ticketId is string&&id==request.resource.data.ticketId+'_'+request.auth.uid;allow delete:if signedIn()&&resource.data.userId==request.auth.uid;allow update:if false;} match /followers/{id}{allow read:if true;allow create:if signedIn()&&request.resource.data.keys().hasOnly(['followingId','followerId','createdAt'])&&request.resource.data.followingId is string&&request.resource.data.followerId==request.auth.uid&&request.resource.data.followingId!=request.auth.uid&&id==request.resource.data.followingId+'_'+request.auth.uid&&request.resource.data.createdAt==request.time&&exists(/databases/$(database)/documents/users/$(request.resource.data.followingId));allow delete:if signedIn()&&resource.data.followerId==request.auth.uid;allow update:if false;} match /reports/{id}{allow create:if signedIn()&&request.resource.data.reporterId==request.auth.uid;allow read,update,delete:if isAdmin();} match /notifications/{id}{allow read,update:if signedIn()&&resource.data.userId==request.auth.uid;allow create,delete:if false;} match /payments/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.userId==request.auth.uid);allow write:if isAdmin();} match /subscriptions/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.userId==request.auth.uid);allow write:if isAdmin();}
  match /{document=**}{allow read,write:if isSuperAdmin();}
 }}
